# MyCoach Configuration
# Copy this file to .env and fill in your values

# App
MYCOACH_ENV=development
MYCOACH_DEBUG=false
MYCOACH_LOG_LEVEL=INFO
MYCOACH_API_TOKEN=
MYCOACH_TIMEZONE=Europe/London

# Security — generate with: python -c "from mycoach.crypto import generate_key; print(generate_key())"
MYCOACH_ENCRYPTION_KEY=

# Database
MYCOACH_DB_URL=sqlite+aiosqlite:///./mycoach.db

# mycoach-db (Postgres, docker-compose.yml) — engine-swap target for the
# observed-athlete-record extraction (map #85, ticket #107). Provisioned but
# not yet the active db_url above; the cutover waits on #104 (drain/sync
# every cached logger session first).
MYCOACH_DATABASE_PASSWORD=

# Garmin (Phase 1)
MYCOACH_GARMIN_EMAIL=
MYCOACH_GARMIN_PASSWORD=
MYCOACH_GARMIN_TOKEN_DIR=.garmin_tokens

# Gym workouts (Phase 9)
# Gym data enters MyCoach two ways, both using MYCOACH_API_TOKEN above:
#   1. Hevy CSV export — upload on the dashboard (POST /api/sources/import/hevy).
#   2. Offline companion logger — the /logger PWA pushes sessions to
#      POST /api/sources/import/workouts with an `X-API-Key: <MYCOACH_API_TOKEN>`
#      header. Set MYCOACH_API_TOKEN to a strong random value to enable it.
#
# The /logger PWA also needs HTTPS to install and work offline (service
# workers only register in a secure context). That's provided by a separate
# shared reverse proxy — see the homelab-edge repo — not by this app or its
# .env; nothing HTTPS-related needs configuring here.
#
# Once /logger is split into its own deployable (the mycoach-logger service
# in docker-compose.yml), it runs on its own origin and calls back here
# cross-origin. Set both of these together, or leave both blank to keep the
# legacy same-origin /logger mount:
#   MYCOACH_LOGGER_ORIGIN — the logger's own origin, e.g.
#     https://logger.yourdomain.com. Opens CORS for it on /api/logger/* and
#     /api/sources/import/workouts, and turns GET /logger into a redirect
#     there instead of serving the old shell.
#   MYCOACH_API_ORIGIN — this app's own origin, e.g. https://mycoach.yourdomain.com,
#     passed to the mycoach-logger container (not this one) so its requests
#     leave its origin correctly. See docker-compose.yml.
MYCOACH_LOGGER_ORIGIN=

# LLM Provider — "anthropic" or "gemini" (add more in coaching/providers/)
MYCOACH_LLM_PROVIDER=anthropic

# Anthropic Claude API
MYCOACH_CLAUDE_API_KEY=
MYCOACH_CLAUDE_MODEL_DAILY=claude-sonnet-4-5-20250929
MYCOACH_CLAUDE_MODEL_WEEKLY=claude-opus-4-6
MYCOACH_CLAUDE_MONTHLY_COST_CEILING=30.0

# Google Gemini API
MYCOACH_GEMINI_API_KEY=
MYCOACH_GEMINI_MODEL_DAILY=gemini-2.5-flash
MYCOACH_GEMINI_MODEL_WEEKLY=gemini-2.5-pro

# Email (Phase 7)
MYCOACH_EMAIL_ENABLED=false
MYCOACH_EMAIL_FROM=
MYCOACH_EMAIL_TO=
MYCOACH_EMAIL_SMTP_HOST=
MYCOACH_EMAIL_SMTP_PORT=587
MYCOACH_EMAIL_SMTP_USER=
MYCOACH_EMAIL_SMTP_PASSWORD=
MYCOACH_EMAIL_RESEND_API_KEY=

# Scheduler (Phase 5)
MYCOACH_SCHEDULER_TIMEZONE=Europe/London
MYCOACH_SCHEDULER_SYNC_HOUR=6
MYCOACH_SCHEDULER_SYNC_MINUTE=0
MYCOACH_SCHEDULER_BRIEFING_HOUR=6
MYCOACH_SCHEDULER_BRIEFING_MINUTE=30
MYCOACH_SCHEDULER_WEEKLY_PLAN_DAY=sun
MYCOACH_SCHEDULER_WEEKLY_PLAN_HOUR=18
MYCOACH_SCHEDULER_WEEKLY_PLAN_MINUTE=0
MYCOACH_SCHEDULER_WEEKLY_RECAP_DAY=mon
MYCOACH_SCHEDULER_WEEKLY_RECAP_HOUR=7
MYCOACH_SCHEDULER_WEEKLY_RECAP_MINUTE=0
